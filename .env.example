# ─────────────────────────────────────────────────────────────────────────────
# Shantaz Technofoods ERP — Environment Variables
#
# Copy this file to `.env` and fill in real values.
# DO NOT commit `.env` to git. `.env` is already in .gitignore.
#
# All Vite env vars MUST be prefixed with VITE_ to be exposed to the client.
# ─────────────────────────────────────────────────────────────────────────────

# ── Supabase (REQUIRED for live mode) ─────────────────────────────────────────
# These three together switch the app into live database mode. In production
# (Vercel) ALL THREE must be set in Project → Settings → Environment Variables,
# then you must REDEPLOY — Vite inlines env vars at BUILD time, so changing them
# without a rebuild has no effect.

VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_xxx_or_anon_jwt
VITE_USE_SUPABASE=true

# ── Build / app metadata ─────────────────────────────────────────────────────
# Set VITE_APP_ENV=production for deployed builds — this strips debug logs and
# disables the in-browser debug helpers (window.__*).
VITE_APP_NAME=Shantaz Technofoods ERP
VITE_APP_ENV=production

# ── Demo / seed data ──────────────────────────────────────────────────────────
# OFF by default. Demo inventory/vendors/POs ONLY load when this is "true" AND
# Supabase is disabled (deliberate offline local dev). Never leave this on for a
# deployed or Supabase-backed build.
VITE_ALLOW_DEMO=false
