# ─────────────────────────────────────────────────────────────────────────────
# Shantaz Technofoods ERP — Environment Variables
#
# Copy this file to `.env` and fill in real values.
# DO NOT commit `.env` to git. `.env` is already in .gitignore.
#
# All Vite env vars MUST be prefixed with VITE_ to be exposed to the client.
# ─────────────────────────────────────────────────────────────────────────────

# ── Supabase ────────────────────────────────────────────────────────────────
# Leave both blank to keep the ERP running on localStorage only (current mode).
# Set both to enable the future multi-user backend (once the migration phases
# in REFACTOR_PLAN are complete).

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# ── Feature flags ────────────────────────────────────────────────────────────
# When true (and Supabase keys above are set), the app routes persistence
# through Supabase instead of localStorage. Defaults to false.

VITE_USE_SUPABASE=false

# ── Build / app metadata ─────────────────────────────────────────────────────
VITE_APP_NAME=Shantaz Technofoods ERP
VITE_APP_ENV=development
